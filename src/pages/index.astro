---
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import Layout from '../layouts/Layout.astro';

// Read all available languages
const i18nDir = join(process.cwd(), 'public', 'i18n');
const languages = readdirSync(i18nDir)
  .filter((f) => f.endsWith('.json'))
  .map((f) => {
    const data = JSON.parse(readFileSync(join(i18nDir, f), 'utf-8'));
    return data.meta;
  });

// Default UI text
const uiChoose = 'Choose your language / اختر لغتك';
---

<Layout title="salah.to – Learn to Pray" description="Free, open-source app teaching Muslim kids how to pray in any language.">
  <main class="min-h-screen flex flex-col items-center justify-center p-6 bg-gradient-to-b from-primary to-blue-900">
    <!-- Logo / Heading -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white shadow-lg mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="48" height="48" role="img" aria-labelledby="logo-title">
          <title id="logo-title">Salah.to logo – crescent moon and star</title>
          <circle cx="28" cy="32" r="20" fill="#1a5276"/>
          <circle cx="36" cy="24" r="14" fill="#ecf0f1"/>
          <polygon points="50,10 52,16 58,16 53,20 55,26 50,22 45,26 47,20 42,16 48,16" fill="#f39c12"/>
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-white mb-2">salah.to</h1>
      <p class="text-blue-200 text-lg">{uiChoose}</p>
    </div>

    <!-- Language Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 w-full max-w-md">
      {languages.map((lang) => (
        <a
          href={`/${lang.lang}/`}
          class="flex flex-col items-center justify-center bg-white rounded-2xl shadow-md p-5 hover:bg-blue-50 hover:scale-105 transition-all duration-200 cursor-pointer group"
          aria-label={`Learn to pray in ${lang.name}`}
          lang={lang.lang}
          dir={lang.dir}
        >
          <span class="text-4xl mb-2" role="img" aria-hidden="true">{lang.flag}</span>
          <span class="text-gray-800 font-semibold text-base text-center">{lang.name}</span>
        </a>
      ))}
    </div>

    <!-- Footer -->
    <footer class="mt-12 text-center text-blue-300 text-sm">
      <p>
        Free & open-source •
        <a
          href="https://github.com/munjed80/Islam"
          class="underline hover:text-white"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View source code on GitHub"
        >GitHub</a>
        • MIT License
      </p>
      <p class="mt-1">No tracking. No cookies. 100% private.</p>
    </footer>
  </main>
</Layout>

<style>
  .from-primary {
    --tw-gradient-from: #1a5276;
  }
</style>
